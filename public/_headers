# Custom headers, honoured by Cloudflare Workers static assets (see
# wrangler.jsonc). The syntax is the one Cloudflare documents here:
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Everything under /_astro/ is content-hashed by Astro's build (the
# hash is part of the filename, e.g. mg6978.BkD4iF7G.webp) — a changed
# file always gets a new URL, so these are safe to cache as long as a
# browser is willing to keep them: a full year, and `immutable` so the
# browser doesn't even revalidate on reload.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
