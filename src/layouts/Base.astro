---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/instrument-sans/wght.css';
import fontUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import { SITE_NAME } from '../lib/site.ts';
import { OG_IMAGE_OPTIONS } from '../lib/og-image.ts';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	/** Alt text for ogImage — falls back to `description` when omitted, same as og:image itself falling back to the featured photo. */
	ogImageAlt?: string;
	/** og:type — 'website' (default), 'article' (/photo/[id]), or 'profile' (/about/). */
	ogType?: 'website' | 'article' | 'profile';
	/** JSON-LD object (or @graph-wrapped object) — see src/lib/schema.ts. */
	structuredData?: Record<string, unknown>;
	/** Responsive image variants to warm the cache for before they're needed — e.g. the lightbox's prev/next photos. */
	preloadImages?: { href: string; imagesrcset: string; imagesizes: string }[];
	/**
	 * robots meta content, e.g. "noindex, follow". Omit for the normal
	 * indexable case. When set, canonical and all og: and twitter: tags are
	 * suppressed too — a noindexed page (404, or a near-duplicate tag
	 * view) shouldn't tell Google or a social-share scraper it has a
	 * preferred canonical URL or a shareable preview.
	 */
	robots?: string;
	/**
	 * Render the site header. Default true; /photo/[id] opts out — it's a
	 * full-bleed black lightbox whose own fixed close/prev/next controls
	 * occupy the same corners. See Header.astro.
	 */
	showHeader?: boolean;
}

const {
	title,
	description,
	ogImage,
	ogImageAlt,
	ogType = 'website',
	structuredData,
	preloadImages,
	robots,
	showHeader = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

let resolvedOgImage = ogImage;
let resolvedOgImageAlt = ogImageAlt;
if (!resolvedOgImage) {
	const photos = await getCollection('photos');
	const featured = photos.find((photo) => photo.data.feature);
	if (featured) {
		const optimized = await getImage({ src: featured.data.src, ...OG_IMAGE_OPTIONS });
		resolvedOgImage = new URL(optimized.src, Astro.site).href;
		resolvedOgImageAlt ??= featured.data.alt;
	}
}

const indexable = !robots?.includes('noindex');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content={SITE_NAME} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		{indexable && <link rel="canonical" href={canonicalURL} />}

		{
			indexable && (
				<>
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					<meta property="og:type" content={ogType} />
					<meta property="og:url" content={canonicalURL} />
					<meta property="og:site_name" content={SITE_NAME} />
					<meta property="og:locale" content="en_US" />
					{resolvedOgImage && (
						<>
							<meta property="og:image" content={resolvedOgImage} />
							{/* Every og:image on the site is generated via OG_IMAGE_OPTIONS
							    (see og-image.ts) — always exactly this shape, so these are
							    safe to hardcode rather than thread through as props. */}
							<meta property="og:image:type" content="image/jpeg" />
							<meta property="og:image:width" content="1200" />
							<meta property="og:image:height" content="630" />
							<meta property="og:image:alt" content={resolvedOgImageAlt ?? description} />
						</>
					)}
					<meta name="twitter:card" content="summary_large_image" />
				</>
			)
		}
		{
			preloadImages?.map((p) => (
				<link rel="preload" as="image" href={p.href} imagesrcset={p.imagesrcset} imagesizes={p.imagesizes} />
			))
		}
		{
			structuredData && (
				<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
			)
		}
		<ClientRouter />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>
		{showHeader && <Header />}
		<slot />
	</body>
</html>

<style>
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		/* Chrome on Android auto-dark-modes a page with no declared
		   color-scheme, inverting the chrome while leaving the (already
		   correctly-colored) photos untouched. */
		color-scheme: light;
		background-color: #fff;
		font-family:
			'Instrument Sans Variable',
			system-ui,
			-apple-system,
			'Segoe UI',
			Roboto,
			sans-serif;
	}

	/* Standard skip-link pattern: off-screen until focused, so a keyboard
	   user's first Tab lands here instead of working through the intro,
	   social links and every filter tab before reaching the photos. Every
	   page's own top-level landmark needs a matching id="main". */
	.skip-link {
		position: absolute;
		top: -100%;
		left: 8px;
		z-index: 100;
		padding: 12px 16px;
		background: #fff;
		color: #000;
		font-size: 16px;
		text-decoration: none;
		border-radius: 4px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
	}

	.skip-link:focus {
		top: 8px;
	}
</style>

<style is:global>
	/* Named view transitions (the detail page's photo, and the in-grid
	   expand/collapse morph) are real browser View Transition API
	   animations, rooted outside the normal DOM tree — they can't be
	   scoped to a component, so this has to be global. */
	::view-transition-group(*) {
		animation-duration: 400ms;
		animation-timing-function: ease-out;
	}

	/* Reduced motion gets an instant cut: no morph, no fade. */
	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(*),
		::view-transition-old(*),
		::view-transition-new(*) {
			animation: none !important;
		}
	}
</style>
