---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/instrument-sans/wght.css';
import fontUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	/** JSON-LD object (or @graph-wrapped object) — see src/lib/schema.ts. */
	structuredData?: Record<string, unknown>;
	/** Responsive image variants to warm the cache for before they're needed — e.g. the lightbox's prev/next photos. */
	preloadImages?: { href: string; imagesrcset: string; imagesizes: string }[];
}

const { title, description, ogImage, structuredData, preloadImages } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

let resolvedOgImage = ogImage;
if (!resolvedOgImage) {
	const photos = await getCollection('photos');
	const featured = photos.find((photo) => photo.data.feature);
	if (featured) {
		const optimized = await getImage({ src: featured.data.src, width: 1200 });
		resolvedOgImage = new URL(optimized.src, Astro.site).href;
	}
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
		<meta name="twitter:card" content="summary_large_image" />
		{
			preloadImages?.map((p) => (
				<link rel="preload" as="image" href={p.href} imagesrcset={p.imagesrcset} imagesizes={p.imagesizes} />
			))
		}
		{
			structuredData && (
				<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
			)
		}
		<ClientRouter />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>
		<slot />
	</body>
</html>

<style>
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	body {
		/* Chrome on Android auto-dark-modes a page with no declared
		   color-scheme, inverting the chrome while leaving the (already
		   correctly-colored) photos untouched. */
		color-scheme: light;
		background-color: #fff;
		font-family:
			'Instrument Sans Variable',
			system-ui,
			-apple-system,
			'Segoe UI',
			Roboto,
			sans-serif;
	}

	/* Standard skip-link pattern: off-screen until focused, so a keyboard
	   user's first Tab lands here instead of working through the intro,
	   social links and every filter tab before reaching the photos. Every
	   page's own top-level landmark needs a matching id="main". */
	.skip-link {
		position: absolute;
		top: -100%;
		left: 8px;
		z-index: 100;
		padding: 12px 16px;
		background: #fff;
		color: #000;
		font-size: 16px;
		text-decoration: none;
		border-radius: 4px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
	}

	.skip-link:focus {
		top: 8px;
	}
</style>

<style is:global>
	/* Named view transitions (the detail page's photo, and the in-grid
	   expand/collapse morph) are real browser View Transition API
	   animations, rooted outside the normal DOM tree — they can't be
	   scoped to a component, so this has to be global. */
	::view-transition-group(*) {
		animation-duration: 400ms;
		animation-timing-function: ease-out;
	}

	/* Reduced motion gets an instant cut: no morph, no fade. */
	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(*),
		::view-transition-old(*),
		::view-transition-new(*) {
			animation: none !important;
		}
	}
</style>
