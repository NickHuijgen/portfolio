---
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { OG_IMAGE_OPTIONS } from '../../../lib/og-image.ts';
import { photoPageSchema } from '../../../lib/schema.ts';
import { getSortedPhotos, photoDetailsUrl, photoUrl } from '../../../lib/photos.ts';

export async function getStaticPaths() {
	const photos = await getSortedPhotos();
	return photos.map((photo, index) => {
		const prev = photos[(index - 1 + photos.length) % photos.length];
		const next = photos[(index + 1) % photos.length];
		return {
			params: { slug: photo.data.slug },
			props: { photo, prev, next },
		};
	});
}

const { photo, prev, next } = Astro.props;
const prevSlug = prev.data.slug;
const nextSlug = next.data.slug;

// `.clone`, not photo.data.src.width/height directly — see the matching
// comment in PhotoGallery.astro. Reading a property straight off an
// image() asset marks it "referenced outside of image processing" and
// defeats Astro's own build-time cleanup of the untransformed original
// it writes to dist/_astro/, which is otherwise unused (only the <Image>
// srcset variants are ever linked). `.clone` is a structuredClone, not
// the proxied object, so reading off it doesn't trip that marking. It's
// not part of the public ImageMetadata type, hence the cast.
const { width: photoWidth, height: photoHeight } = (
	photo.data.src as unknown as { clone: typeof photo.data.src }
).clone;

// The Left/Right controls are the most likely next tap, especially on
// mobile — but touch has nothing equivalent to the hover that would
// otherwise prefetch them (see the `data-astro-prefetch="load"` below for
// the HTML side of that). Warming the *image* cache matters more than the
// HTML: it's the large asset, and a prefetched page doesn't pull in the
// images it references. widths/sizes here must mirror the frame-image
// <Image> below exactly, or the browser won't recognize this as the same
// request and will fetch it again anyway.
const FRAME_IMAGE_WIDTHS = [800, 1600, 2400];
const FRAME_IMAGE_SIZES = '100vw';
const adjacentPhotos = prev.id === next.id ? [prev] : [prev, next];
const preloadImages = await Promise.all(
	adjacentPhotos.map(async (adjacent) => {
		const optimized = await getImage({ src: adjacent.data.src, widths: FRAME_IMAGE_WIDTHS });
		return {
			href: optimized.src,
			imagesrcset: optimized.srcSet.attribute,
			imagesizes: FRAME_IMAGE_SIZES,
		};
	}),
);

const formattedDate = photo.data.date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const exif = photo.data.exif;
const formattedExif =
	exif &&
	[
		exif.camera,
		exif.lens,
		`${exif.focalLength}mm`,
		`f/${exif.aperture}`,
		exif.shutterSpeed >= 1 ? `${exif.shutterSpeed}s` : `1/${Math.round(1 / exif.shutterSpeed)}s`,
		`ISO ${exif.iso}`,
	].join(' · ');

const structuredData = await photoPageSchema(photo);

// Base.astro falls back to the collection's single `feature: true` photo
// for og:image when no ogImage is given — fine for the homepage/tag pages,
// but every /photo/[slug] page shares one photo, so sharing this URL (e.g.
// on WhatsApp) always previewed that same featured photo instead of this one.
const ogImageAsset = await getImage({ src: photo.data.src, ...OG_IMAGE_OPTIONS });
const ogImage = new URL(ogImageAsset.src, Astro.site).href;
---

<Base
	title={`${photo.data.title} — Nick Huijgen`}
	description={photo.data.caption ?? photo.data.alt}
	ogImage={ogImage}
	ogImageAlt={photo.data.alt}
	ogType="article"
	structuredData={structuredData}
	preloadImages={preloadImages}
	showHeader={false}
>
	<main class="photo-detail" id="main" tabindex="-1" data-photo-slug={photo.data.slug}>
		<h1 class="visually-hidden">{photo.data.title}</h1>
		<a
			href={photoUrl(photo.data.slug)}
			id="photo-close"
			class="control close"
			autofocus
			aria-label="Close"
		>
			✕
		</a>
		<a
			href={photoDetailsUrl(prevSlug)}
			id="photo-prev"
			class="control prev"
			aria-label="Previous photo"
			data-astro-prefetch="load"
		>
			‹
		</a>
		<a
			href={photoDetailsUrl(nextSlug)}
			id="photo-next"
			class="control next"
			aria-label="Next photo"
			data-astro-prefetch="load"
		>
			›
		</a>

		<figure class="frame">
			<Image
				src={photo.data.src}
				alt={photo.data.alt}
				widths={FRAME_IMAGE_WIDTHS}
				sizes={FRAME_IMAGE_SIZES}
				class="frame-image"
				style={`--frame-ar: ${photoWidth} / ${photoHeight};`}
				loading="eager"
				fetchpriority="high"
				transition:name={`photo-${photo.data.slug}`}
			/>
		</figure>

		<div class="meta">
			{photo.data.caption && <p class="caption">{photo.data.caption}</p>}
			<p class="date">{formattedDate}</p>
			{photo.data.location && <p class="location">{photo.data.location}</p>}
			{exif && <p class="exif">{formattedExif}</p>}
			<ul class="tags" role="list">
				{
					photo.data.tags.map((tag) => (
						<li>
							<a href={`/tag/${tag}/`}>{tag}</a>
						</li>
					))
				}
			</ul>
		</div>
	</main>
</Base>

<script is:inline>
	// No define:vars here on purpose — it made this script's text unique
	// per photo (`const photoSlug = "sleeping-tiger"` vs the next photo's),
	// which defeats Astro's inline-script dedup (keyed on exact textContent:
	// see swap-functions.js). `document` survives ClientRouter swaps —
	// only `document.body` is replaced — so a re-run on every distinct
	// photo page visited left one extra `keydown` listener behind each
	// time (up to 64/session), each later throwing on the grid (where
	// #photo-close doesn't exist) and, worse, firing N stale `.click()`s
	// per arrow key once N photos had been visited. The photo's slug now
	// comes from a `data-photo-slug` attribute (read fresh from the
	// swapped-in DOM) instead, so this script's text is identical on
	// every photo page and only ever runs once per session.
	document.addEventListener('astro:page-load', () => {
		const main = document.querySelector('.photo-detail');
		const closeLink = document.getElementById('photo-close');
		if (!main || !closeLink) return;
		try {
			// { slug, ts } rather than a bare slug: PhotoGallery.astro's
			// consumer only honors this if it's fresh (see the comment
			// there) — a bare slug would keep pointing at whatever photo was
			// last viewed indefinitely, yanking focus to it on a much later,
			// unrelated visit to the grid. The slug is the grid thumbnail's
			// DOM id, so it's what that consumer focuses by.
			sessionStorage.setItem(
				'focusPhoto',
				JSON.stringify({ slug: main.dataset.photoSlug, ts: Date.now() }),
			);
		} catch {
			// Blocked cookies/storage, enterprise policy, sandboxed frame —
			// this is a nice-to-have (focus restoration on the grid), not
			// essential, and it's wrapped so a SecurityError here can't
			// abort the rest of this handler (close-href rewrite below).
		}
		// Close should return to whichever tag filter was active on the grid
		// this photo was opened from, not always the unfiltered "All" view —
		// this page is a separate static route with no way to know that at
		// render time (arriving here doesn't have to come from the grid at
		// all — a shared link, a search result), so it's read back out of
		// sessionStorage instead. PhotoGallery.astro keeps that in sync
		// whenever the filter changes or a /tag/[tag] page loads directly.
		let activeTag;
		try {
			activeTag = sessionStorage.getItem('activeTag');
		} catch {}
		if (activeTag) {
			closeLink.href = `/tag/${encodeURIComponent(activeTag)}/#photos`;
		}
		// `autofocus` only applies during the browser's initial parse of a
		// fresh Document — ClientRouter swaps this page's content into the
		// existing Document rather than loading a new one, so the
		// autofocus-processed flag stays set after the very first load and
		// the attribute is silently ignored on every later arrival here
		// (clicking a grid thumbnail, prev/next, back/forward). Focus
		// explicitly instead so a keyboard user always lands on Close.
		closeLink.focus();
	});

	if (!window.__photoDetailKeysInit) {
		window.__photoDetailKeysInit = true;
		document.addEventListener('keydown', (e) => {
			// Cmd+Left (macOS) / Alt+Left (Windows/Linux) are browser Back;
			// don't also step to the previous photo on top of that.
			if (e.metaKey || e.altKey || e.ctrlKey) return;
			if (e.key === 'Escape') document.getElementById('photo-close')?.click();
			else if (e.key === 'ArrowLeft') document.getElementById('photo-prev')?.click();
			else if (e.key === 'ArrowRight') document.getElementById('photo-next')?.click();
		});
	}
</script>

<style>
	/* Reach the real <body> (rendered by Base.astro, not this page's own
	   template) to kill its default UA margin — otherwise the browser's
	   8px body margin leaves a white gutter around this page's full-bleed
	   dark background. Scoped to this page only, not Base.astro, so
	   every other page keeps its current spacing. */
	:global(body) {
		margin: 0;
	}

	.photo-detail {
		position: relative;
		box-sizing: border-box;
		min-height: 100vh;
		/* 100dvh accounts for mobile browser chrome (e.g. iOS Safari's URL
		   bar) that 100vh doesn't — without it the flex-centered content
		   can center within a box taller than what's actually visible,
		   pushing the caption/EXIF/tags under the URL bar. Kept as a
		   fallback for browsers without dvh support. */
		min-height: 100dvh;
		padding: 72px 24px 32px;
		background: #000;
		color: #fff;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
	}

	#main:focus-visible {
		outline: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.control {
		/* z-index is required here: the large image carries an active
		   view-transition-name, which promotes it into its own
		   top-level compositing layer even outside an active
		   transition — without this, it paints above fixed-position
		   siblings that have no z-index of their own. */
		position: fixed;
		z-index: 10;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 8px;
		color: #fff;
		text-decoration: none;
		font-size: 20px;
		line-height: 1;
		border-radius: 50%;
		/* 0.45 composited over a bright photo (sky, snow, blown highlights)
		   measured 3.36:1 for the white glyph — fails AA. 0.65 -> 7.00:1. */
		background: rgba(0, 0, 0, 0.65);
	}

	.close {
		top: 12px;
		right: 12px;
		font-size: 18px;
	}

	.prev {
		top: 50%;
		left: 12px;
		transform: translateY(-50%);
		font-size: 32px;
	}

	.next {
		top: 50%;
		right: 12px;
		transform: translateY(-50%);
		font-size: 32px;
	}

	.control:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	/* Windows High Contrast strips background colors (including this
	   rgba scrim), leaving ✕/‹/› with no visible boundary against the
	   photo. A forced-colors-safe outline keeps them legible. */
	@media (forced-colors: active) {
		.control {
			outline: 1px solid CanvasText;
		}
	}

	.frame {
		margin: 0;
		max-width: 100%;
		/* #main is a centered flex column, so this figure would otherwise be
		   fit-content — i.e. its width would depend on the image inside it.
		   That leaves the image with no definite containing-block width to
		   resolve against, which is half of why the box below used to
		   collapse. Stretching the figure gives it one; the image re-centers
		   itself with margin-inline below. */
		align-self: stretch;
	}

	.frame-image {
		display: block;
		/* This deliberately encodes the old `max-width: 100%; max-height: 90vh`
		   pair as a single *definite* width, rather than leaving width/height
		   `auto`. The old version shifted layout: until the image responded,
		   its box was 0x0 and everything below it sat ~240px too high, then
		   jumped down on load (CLS 0.065 on a slow connection, ~0 on a fast
		   one — which is why browsing from the grid never showed it).

		   `width: auto` was the cause. It overrides the width/height
		   attributes Astro emits, which are what would otherwise give a
		   not-yet-loaded image its intrinsic size, so `aspect-ratio` had no
		   definite axis to work from and the element collapsed.

		   Two fixes that look right and aren't, both measured: dropping the
		   auto declarations reserves the right box but stretches the image to
		   364x741 once loaded, and `width: 100%` still collapses to 0x0
		   (that's the fit-content figure above). min() reproduces exactly
		   what max-width/max-height used to compute — verified identical at
		   viewport heights where the 90vh cap binds and where it doesn't. */
		width: min(100%, calc(90vh * var(--frame-ar)));
		height: auto;
		aspect-ratio: var(--frame-ar);
		margin-inline: auto;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 8px 16px;
		max-width: 100%;
	}

	.meta .caption {
		flex-basis: 100%;
		margin: 0;
		font-size: 0.9375rem;
		color: #fff;
		text-align: center;
	}

	.meta .date {
		margin: 0;
		font-size: 0.8125rem;
		color: #999;
	}

	.meta .location {
		margin: 0;
		font-size: 0.8125rem;
		color: #999;
	}

	.meta .exif {
		margin: 0;
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.8);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: #ccc;
		font-size: 0.8125rem;
		text-decoration: underline;
		text-underline-offset: 2px;
		text-transform: capitalize;
	}

	.tags a:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
</style>
