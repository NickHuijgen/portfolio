---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getAbout } from '../../lib/about.ts';
import { aboutPageSchema } from '../../lib/schema.ts';
import { INSTAGRAM_URL, LINKEDIN_URL } from '../../lib/site.ts';
import { OG_IMAGE_OPTIONS } from '../../lib/og-image.ts';
import { LOCALES, isLocale, localizedPath, UI, type Locale } from '../../lib/i18n.ts';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLocale(rawLang)) throw new Error(`Invalid lang param: ${rawLang}`);
const lang: Locale = rawLang;

const about = await getAbout(lang);
const paragraphs = about.body.split(/\n{2,}/);

// Base.astro's og:image fallback is the collection's single feature:true
// photo (a wildlife shot) — fine elsewhere, but wrong for a page about
// Nick himself. Use the portrait instead, when one's set.
const ogImage = about.portrait
	? new URL((await getImage({ src: about.portrait, ...OG_IMAGE_OPTIONS })).src, Astro.site).href
	: undefined;

const structuredData = await aboutPageSchema(lang);
---

<Base
	lang={lang}
	title={`${UI[lang].aboutTitle} — Nick Huijgen`}
	description={about.homeIntro}
	ogImage={ogImage}
	ogImageAlt={about.portraitAlt}
	ogType="profile"
	structuredData={structuredData}
>
	<main class="about" id="main" tabindex="-1">
		<h1 class="heading">{about.heading}</h1>
		<div class="portrait-col">
			{
				about.portrait ? (
					<Image
						src={about.portrait}
						alt={about.portraitAlt ?? 'Nick Huijgen'}
						width={800}
						class="portrait"
					/>
				) : (
					<div class="portrait portrait-placeholder" aria-hidden="true">
						NH
					</div>
				)
			}
		</div>
		<div class="content-col">
			{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			<dl class="facts">
				{
					about.facts.map((fact) => (
						<div class="fact">
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))
				}
			</dl>
			<div class="cta">
				<a href={localizedPath('/', lang) + '#photos'} class="button">
					{UI[lang].viewPhotos}
				</a>
				<div class="social-links">
					<a href={LINKEDIN_URL} class="social-link" target="_blank" rel="me noopener">
						LinkedIn<span class="visually-hidden">{UI[lang].opensInNewTab}</span>
					</a>
					<a href={INSTAGRAM_URL} class="social-link" target="_blank" rel="me noopener">
						Instagram<span class="visually-hidden">{UI[lang].opensInNewTab}</span>
					</a>
				</div>
			</div>
		</div>
	</main>
</Base>

<style>
	/* See Home.astro's identical rule: #main is a skip-link jump target,
	   not an interactive control — a default focus ring around the whole
	   page is noise for sighted users; assistive tech still announces
	   the landing regardless of visual styling. */
	#main:focus-visible {
		outline: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.about {
		max-width: 1200px;
		margin: 0 auto;
		padding-block: 32px 64px;
		display: grid;
		grid-template-columns: 1fr;
		/* Heading before the portrait: landing on the page (mobile especially,
		   where these stack) shouldn't show a photo with no context before
		   any text. Desktop reflows the same three pieces into a
		   portrait-left/text-right layout via named areas, independent of
		   this source order. */
		grid-template-areas:
			'heading'
			'portrait'
			'content';
		gap: 24px;
	}

	@media (min-width: 700px) {
		.about {
			grid-template-columns: minmax(240px, 320px) 1fr;
			grid-template-areas:
				'portrait heading'
				'portrait content';
			column-gap: 48px;
			row-gap: 16px;
			align-items: start;
		}
	}

	.heading {
		grid-area: heading;
		margin: 0;
		font-size: 1.75rem;
		font-weight: 500;
	}

	.portrait-col {
		grid-area: portrait;
		max-width: 320px;
	}

	.content-col {
		grid-area: content;
	}

	.portrait {
		display: block;
		width: 100%;
		/* Explicit (not just relying on the initial value) — with both the
		   `width`/`height` HTML attributes astro:assets sets (from the
		   source image's own dimensions, which don't match this 3:4 crop)
		   present, at least one Chromium build renders the box at the
		   attribute height verbatim instead of deriving it from
		   `aspect-ratio`, unless `height: auto` is authored explicitly.
		   Confirmed via a minimal repro image outside this page/grid. */
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 4px;
	}

	.portrait-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #eee;
		color: #666;
		font-size: 1.5rem;
		font-weight: 500;
	}

	.content-col p {
		margin: 0 0 16px;
		font-size: 1.0625rem;
		line-height: 1.6;
		max-width: 40em;
	}

	.facts {
		margin: 24px 0 0;
		padding-top: 24px;
		border-top: 1px solid #eee;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px 24px;
		max-width: 40em;
	}

	.fact {
		margin: 0;
	}

	.fact dt {
		margin: 0 0 2px;
		font-size: 0.8125rem;
		color: #666;
	}

	.fact dd {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.cta {
		--text-secondary: #666;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 20px;
		border: 1px solid currentColor;
		border-radius: 4px;
		color: inherit;
		font-size: 16px;
		text-decoration: none;
	}

	.button:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.button {
			width: 100%;
			justify-content: center;
		}
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--text-secondary);
		font-size: 16px;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.social-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}
</style>
