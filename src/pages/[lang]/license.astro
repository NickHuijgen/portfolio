---
import Base from '../../layouts/Base.astro';
import { licensePageSchema } from '../../lib/schema.ts';
import { INSTAGRAM_URL } from '../../lib/site.ts';
import { LOCALES, isLocale, UI, type Locale } from '../../lib/i18n.ts';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
if (!isLocale(rawLang)) throw new Error(`Invalid lang param: ${rawLang}`);
const lang: Locale = rawLang;

// Referenced from every photo's ImageObject (license + acquireLicensePage
// — see src/lib/schema.ts) so Google Images can show licensing info
// alongside search results. Both schema.org properties need a real page
// with real terms behind them, or Google ignores them — this is that
// page, not just a link target.
const structuredData = await licensePageSchema(lang);
---

<Base
	lang={lang}
	title={`${UI[lang].licenseTitle} — Nick Huijgen`}
	description={UI[lang].licenseDescription}
	structuredData={structuredData}
>
	<main class="intro" id="main" tabindex="-1">
		<h1>{UI[lang].licenseTitle}</h1>
		<p>
			{UI[lang].licenseTerms}
		</p>
		<p>
			{UI[lang].licenseContactBefore}<a href={INSTAGRAM_URL} target="_blank" rel="me noopener"
				>Instagram<span class="visually-hidden">{UI[lang].opensInNewTab}</span></a
			>{UI[lang].licenseContactAfter}
		</p>
	</main>
</Base>

<style>
	#main:focus-visible {
		outline: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.intro {
		max-width: 1200px;
		margin: 0 auto;
		padding-block: 32px 48px;
	}

	.intro h1 {
		margin: 0 0 1rem;
		font-size: 2rem;
		font-weight: 500;
	}

	.intro p {
		margin: 0 0 1rem;
		font-size: 1.125rem;
		max-width: 40em;
	}

	.intro a {
		color: inherit;
	}
</style>
