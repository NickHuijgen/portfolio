---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Nick Huijgen" description="This page doesn't exist.">
	<section class="intro">
		<p>Page not found. <a href="/">Back to the homepage</a>.</p>
	</section>
</Base>

<style>
	.intro {
		max-width: 1200px;
		margin: 0 auto;
		padding-block: 64px 48px;
	}

	.intro p {
		margin: 0;
		font-size: 1.125rem;
	}

	.intro a {
		color: inherit;
	}
</style>
