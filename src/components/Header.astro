---
import { SITE_NAME } from '../lib/site.ts';

// Rendered by Base.astro on every page except /photo/[slug] — see the
// `showHeader` prop there. The lightbox is full-bleed black with its
// own fixed close/prev/next controls in exactly this corner; a second
// row of chrome would fight them, and that page already has a Close
// that knows where to go back to.
//
// Deliberately absent, in the name of "as little visual clutter as
// possible": no background fill, no bottom border, no sticky
// positioning. A bar that follows you down the grid is permanent
// visual weight over the one thing the page exists to show, so this
// scrolls away with everything else. Only two nav links, too — the tag
// filters (PhotoGallery.astro) are the photo section's own navigation,
// and /license/ lives in the copyright footer (Home.astro) rather than
// needing a slot up here.
//
// Photos points at /#photos rather than / so it isn't just a second
// wordmark: it skips the intro and lands on the grid, same target as
// the intro's own "View photos" button.
//
// The two nav links carry aria-current; the wordmark deliberately
// doesn't. Partly convention (site identity, not a nav item), but
// mostly because a wordmark one would go stale: PhotoGallery.astro's
// filter switch rewrites the URL from / to /tag/<tag>/ client-side
// without re-rendering anything from the server, so a wordmark marked
// current on / would keep claiming to be the current page on
// /tag/portrait/ — the same server-vs-client drift AGENTS.md's
// Invariants table already tracks for tagCopy(). Neither nav link can
// drift that way, which is exactly why isPhotos spans / AND /tag/*:
// both sides of a client-side filter switch are "the photos", so the
// server-rendered answer stays true however the filter moves. Two
// aria-current="page" links on the grid (this one and the filter nav's
// "All") is intentional and the normal primary-nav/sub-nav pattern —
// they answer different questions ("which section" vs "which filter").
//
// trailingSlash: 'always' (astro.config.mjs), so these compare against
// the trailing-slash forms.
const path = Astro.url.pathname;
const isPhotos = path === '/' || path.startsWith('/tag/');
---

<header class="site-header">
	<nav class="bar" aria-label="Site">
		<a href="/" class="wordmark">{SITE_NAME}</a>
		<div class="links">
			<a href="/#photos" class="nav-link" aria-current={isPhotos ? 'page' : undefined}>Photos</a>
			<a href="/about/" class="nav-link" aria-current={path === '/about/' ? 'page' : undefined}>
				About
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		--text-secondary: #666;
	}

	/* Same max-width + auto margins as .intro, .about, .filters, .grid and
	   .site-footer, so the wordmark sits on the same left edge as the
	   avatar and the grid's first column at every width. No horizontal
	   padding of its own for the same reason — the page gutter is the
	   body margin (see AGENTS.md's Style section). */
	.bar {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	/* 16px between the nav links, matching the filter nav's column-gap —
	   wide enough that two adjacent 44px targets don't mis-tap, narrow
	   enough that all three items still fit on one line at 320px. */
	.links {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	/* No block padding on .bar: the 44px touch targets below are the
	   header's whole height (~44px), which is as short as it can be
	   without shrinking the tap area. */
	.wordmark,
	.nav-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 0.9375rem;
		line-height: 1.5;
		text-decoration: none;
	}

	.wordmark {
		color: inherit;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	.nav-link {
		color: var(--text-secondary);
	}

	/* Underline only on hover/focus/current, rather than always: these are
	   standalone links in a recognised position, not links inside a block
	   of text (where WCAG 1.4.1 would want the underline permanently). */
	.wordmark:hover,
	.nav-link:hover,
	.nav-link[aria-current='page'] {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.nav-link[aria-current='page'] {
		color: inherit;
	}

	.wordmark:focus-visible,
	.nav-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}
</style>
