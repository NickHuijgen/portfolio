---
import { Image } from 'astro:assets';
import PhotoGallery from './PhotoGallery.astro';
import { getAbout } from '../lib/about.ts';

interface Props {
	activeTag?: string;
}

const { activeTag } = Astro.props;

const LINKEDIN_URL = 'https://www.linkedin.com/in/nickhuijgen/';
const INSTAGRAM_URL = 'https://www.instagram.com/nickhuijgen/';

const about = await getAbout();
---

<section class="intro">
	<div class="who">
		<span class="avatar-frame">
			{
				about.portrait ? (
					<Image
						src={about.portrait}
						alt={about.portraitAlt ?? 'Nick Huijgen'}
						width={512}
						class="avatar"
					/>
				) : (
					<div class="avatar-placeholder" aria-hidden="true">
						NH
					</div>
				)
			}
		</span>
		<h1>Nick Huijgen</h1>
	</div>
	<p>Photography from wherever I end up.</p>
	<p class="bio">
		{about.homeIntro} <a href="/about/" class="more-link">More about me</a>
	</p>
	<div class="cta">
		<a href="#photos" class="button">View photos</a>
		<div class="social-links">
			<a href={LINKEDIN_URL} class="social-link" target="_blank" rel="noopener">LinkedIn</a>
			<a href={INSTAGRAM_URL} class="social-link" target="_blank" rel="noopener">Instagram</a>
		</div>
	</div>
</section>

<section id="photos">
	<PhotoGallery activeTag={activeTag} />
</section>

<footer class="site-footer">© 2026 Nick Huijgen. All rights reserved.</footer>

<style>
	.intro {
		--text-secondary: #666;
		max-width: 1200px;
		margin: 0 auto;
		padding-block: 64px 48px;
	}

	.who {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.avatar-frame {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		overflow: hidden;
	}

	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* The source is a full-body environmental portrait, not a
		   headshot — object-fit:cover on a 1:1 frame only trims the
		   excess top/bottom (the image is much taller than it is wide),
		   which leaves the face tiny. Scaling up around the face's
		   position in the frame zooms in the way object-fit alone
		   can't; avatar-frame's overflow:hidden clips the zoomed-in
		   overflow back down to the 64px circle. Re-tune if the source
		   photo ever changes — these numbers are specific to where the
		   face falls in this particular shot. */
		transform: scale(4);
		transform-origin: 47% 33%;
	}

	.avatar-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #eee;
		color: var(--text-secondary);
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.intro h1 {
		margin: 0;
		font-size: 2rem;
		font-weight: 500;
	}

	.intro p {
		margin: 0.5rem 0 0;
		font-size: 1.125rem;
	}

	.bio {
		color: var(--text-secondary);
		font-size: 1rem;
		max-width: 40em;
	}

	.more-link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.more-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 20px;
		border: 1px solid currentColor;
		border-radius: 4px;
		color: inherit;
		font-size: 16px;
		text-decoration: none;
	}

	.button:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.button {
			width: 100%;
			justify-content: center;
		}
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--text-secondary);
		font-size: 16px;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.social-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	#photos {
		scroll-margin-top: 2rem;
	}

	.site-footer {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 0 48px;
		color: var(--text-secondary, #666);
		font-size: 0.8125rem;
	}
</style>
