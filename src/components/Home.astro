---
import { Image } from 'astro:assets';
import PhotoGallery from './PhotoGallery.astro';
import { getAbout } from '../lib/about.ts';
import { INSTAGRAM_URL, LINKEDIN_URL } from '../lib/site.ts';
import { tagCopy } from '../lib/tag-copy.ts';

interface Props {
	activeTag?: string;
	/** Required alongside activeTag — the caller (tag/[tag].astro) already has this count from building the page, so Home.astro doesn't re-fetch and re-filter the whole collection just to get it again. */
	activeTagCount?: number;
	/** Slug of a photo whose tile should render already expanded — set only by /photo/[slug]/index.astro, the share-landing page. Forwarded straight to PhotoGallery. */
	openSlug?: string;
}

const { activeTag, activeTagCount, openSlug } = Astro.props;

const about = await getAbout();

// A hardcoded "Nick Huijgen" h1 + fixed intro paragraph on every tag
// page (as well as /) is most of why / and /tag/[tag] measured 0.9998
// similar with scripts/styles stripped — near-duplicate content Google
// has no reason to index all of separately. Tag-aware heading + lead
// line instead (tagCopy — shared with tag/[tag].astro's <title>):
// genuinely different text per tag while staying true to what's
// actually on the page. This is server-rendered only — a client-side
// filter switch on `/` (PhotoGallery.astro's applyFilter) deliberately
// leaves this heading/lead alone rather than mirroring tagCopy, so
// clicking a filter pill never changes the page head.
const { heading: tagHeading, lead: tagLead } = activeTag
	? tagCopy(activeTag, activeTagCount ?? 0)
	: { heading: undefined, lead: undefined };
---

<main id="main" tabindex="-1">
	<section class="intro">
		<div class="who">
			<span class="avatar-frame">
				{
					/* `loading="eager"` on the avatar branch only. It's above the
					   fold, so skipping the browser's lazy threshold is worth it:
					   measured 880ms -> 450ms to paint it, with LCP unchanged at
					   1380ms. That only holds because `about.avatar` is a ~3kB
					   square — the `portrait` fallback stays lazy, since
					   eager-loading the 45kB full-body shot measured ~60ms *worse*
					   LCP (it competes with the grid's LCP photo for bandwidth). */
				}
				{
					about.avatar ? (
						<Image
							src={about.avatar}
							alt={about.portraitAlt ?? 'Nick Huijgen'}
							widths={[128, 192]}
							sizes="64px"
							class="avatar"
							loading="eager"
						/>
					) : about.portrait ? (
						<Image
							src={about.portrait}
							alt={about.portraitAlt ?? 'Nick Huijgen'}
							width={512}
							class="avatar avatar-zoomed"
						/>
					) : (
						<div class="avatar-placeholder" aria-hidden="true">
							NH
						</div>
					)
				}
			</span>
			<div class="heading-group">
				<h1>{tagHeading ?? 'Nick Huijgen'}</h1>
				{tagHeading && <p class="byline">by Nick Huijgen</p>}
			</div>
		</div>
		<p class="lead">{tagLead ?? 'Photography from wherever I end up.'}</p>
		<p class="bio">
			{about.homeIntro} <a href="/about/" class="more-link">More about me</a>
		</p>
		<div class="cta">
			<a href="#photos" class="button">View photos</a>
			<div class="social-links">
				<a href={LINKEDIN_URL} class="social-link" target="_blank" rel="me noopener">
					LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
				</a>
				<a href={INSTAGRAM_URL} class="social-link" target="_blank" rel="me noopener">
					Instagram<span class="visually-hidden"> (opens in a new tab)</span>
				</a>
			</div>
		</div>
	</section>

	<section id="photos" tabindex="-1">
		<PhotoGallery activeTag={activeTag} openSlug={openSlug} />
	</section>
</main>

<footer class="site-footer">
	© {new Date().getFullYear()} Nick Huijgen. All rights reserved. <a href="/license/">Licensing</a>
</footer>

<style>
	/* Skip-link and "View photos" jump targets (#main, #photos below) are
	   sections, not interactive controls — a default focus ring around
	   the whole intro or all 64 photos is more noise than signal for
	   sighted users, while assistive tech still announces landing here
	   regardless of visual styling. */
	#main:focus-visible {
		outline: none;
	}

	.intro {
		--text-secondary: #666;
		max-width: 1200px;
		margin: 0 auto;
		/* 32px, not the 64px this was before the site header existed —
		   the header now supplies the space above the fold that this
		   padding used to. Same reduction in 404.astro/license.astro. */
		padding-block: 32px 48px;
	}

	.who {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.avatar-frame {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		overflow: hidden;
	}

	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Fallback path only — `about.avatar` unset, so this is the full-body
	   portrait rather than a headshot, and object-fit:cover on a 1:1 frame
	   would only trim the excess top/bottom (the image is much taller than
	   it is wide), leaving the face tiny. Scaling up around the face's
	   position zooms in the way object-fit alone can't; avatar-frame's
	   overflow:hidden clips the overflow back to the 64px circle.

	   It costs what you'd expect: the browser fetches the whole portrait
	   (~45kB at the 512px width this needs to stay sharp at 2x once
	   magnified 4x) to paint a 64px circle, because only a 128x128 region
	   of it is ever visible. `about.avatar` exists to skip that — a
	   pre-cropped square is ~4kB for the same result. These numbers are
	   specific to where the face falls in this particular shot, so re-tune
	   them if the portrait changes and no avatar is set. */
	.avatar-zoomed {
		transform: scale(4);
		transform-origin: 47% 33%;
	}

	.avatar-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #eee;
		color: var(--text-secondary);
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.intro h1 {
		margin: 0;
		font-size: 2rem;
		font-weight: 500;
	}

	.heading-group {
		min-width: 0;
	}

	/* Specificity needs to beat the generic `.intro p` rule below, which
	   would otherwise win (class+element beats class alone) and undo
	   this sizing/spacing. */
	.intro .byline {
		margin: 2px 0 0;
		font-size: 0.9375rem;
		color: var(--text-secondary);
	}

	.intro p {
		margin: 0.5rem 0 0;
		font-size: 1.125rem;
	}

	.bio {
		color: var(--text-secondary);
		font-size: 1rem;
		max-width: 40em;
	}

	.more-link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.more-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 20px;
		border: 1px solid currentColor;
		border-radius: 4px;
		color: inherit;
		font-size: 16px;
		text-decoration: none;
	}

	.button:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.button {
			width: 100%;
			justify-content: center;
		}
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--text-secondary);
		font-size: 16px;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.social-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	#photos {
		scroll-margin-top: 2rem;
	}

	#photos:focus-visible {
		outline: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.site-footer {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 0 48px;
		color: var(--text-secondary, #666);
		font-size: 0.8125rem;
	}

	.site-footer a {
		color: inherit;
	}

	.site-footer a:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}
</style>
