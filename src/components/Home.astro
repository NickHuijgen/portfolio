---
import { Image } from 'astro:assets';
import PhotoGallery from './PhotoGallery.astro';
import { getAbout } from '../lib/about.ts';
import { getSortedPhotos, photoMatchesTag } from '../lib/photos.ts';
import { INSTAGRAM_URL, LINKEDIN_URL } from '../lib/site.ts';

interface Props {
	activeTag?: string;
}

const { activeTag } = Astro.props;

const about = await getAbout();

// A hardcoded "Nick Huijgen" h1 + fixed intro paragraph on every tag
// page (as well as /) is most of why / and /tag/[tag] measured 0.9998
// similar with scripts/styles stripped — near-duplicate content Google
// has no reason to index all of separately. Tag-aware heading + lead
// line instead: genuinely different text per tag (not hand-authored
// prose per tag name, which would go stale the moment a new tag shows
// up — see .pages.yml's already-stale options list for exactly that
// failure mode) while staying true to what's actually on the page.
let tagHeading: string | undefined;
let tagLead: string | undefined;
if (activeTag) {
	const count = (await getSortedPhotos()).filter((photo) => photoMatchesTag(photo, activeTag)).length;
	if (activeTag === 'featured') {
		tagHeading = 'Featured photos';
		tagLead = `A selection of ${count} favorite${count === 1 ? '' : 's'}.`;
	} else {
		tagHeading = `${activeTag[0].toUpperCase()}${activeTag.slice(1)} photography`;
		tagLead = `${count} photo${count === 1 ? '' : 's'} tagged "${activeTag}".`;
	}
}
---

<main id="main" tabindex="-1">
	<section class="intro">
		<div class="who">
			<span class="avatar-frame">
				{
					about.portrait ? (
						<Image
							src={about.portrait}
							alt={about.portraitAlt ?? 'Nick Huijgen'}
							width={512}
							class="avatar"
						/>
					) : (
						<div class="avatar-placeholder" aria-hidden="true">
							NH
						</div>
					)
				}
			</span>
			<div class="heading-group">
				<h1>{tagHeading ?? 'Nick Huijgen'}</h1>
				{tagHeading && <p class="byline">by Nick Huijgen</p>}
			</div>
		</div>
		<p>{tagLead ?? 'Photography from wherever I end up.'}</p>
		<p class="bio">
			{about.homeIntro} <a href="/about/" class="more-link">More about me</a>
		</p>
		<div class="cta">
			<a href="#photos" class="button">View photos</a>
			<div class="social-links">
				<a href={LINKEDIN_URL} class="social-link" target="_blank" rel="me noopener">
					LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
				</a>
				<a href={INSTAGRAM_URL} class="social-link" target="_blank" rel="me noopener">
					Instagram<span class="visually-hidden"> (opens in a new tab)</span>
				</a>
			</div>
		</div>
	</section>

	<section id="photos" tabindex="-1">
		<PhotoGallery activeTag={activeTag} />
	</section>
</main>

<footer class="site-footer">© 2026 Nick Huijgen. All rights reserved.</footer>

<style>
	/* Skip-link and "View photos" jump targets (#main, #photos below) are
	   sections, not interactive controls — a default focus ring around
	   the whole intro or all 64 photos is more noise than signal for
	   sighted users, while assistive tech still announces landing here
	   regardless of visual styling. */
	#main:focus-visible {
		outline: none;
	}

	.intro {
		--text-secondary: #666;
		max-width: 1200px;
		margin: 0 auto;
		padding-block: 64px 48px;
	}

	.who {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.avatar-frame {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		overflow: hidden;
	}

	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* The source is a full-body environmental portrait, not a
		   headshot — object-fit:cover on a 1:1 frame only trims the
		   excess top/bottom (the image is much taller than it is wide),
		   which leaves the face tiny. Scaling up around the face's
		   position in the frame zooms in the way object-fit alone
		   can't; avatar-frame's overflow:hidden clips the zoomed-in
		   overflow back down to the 64px circle. Re-tune if the source
		   photo ever changes — these numbers are specific to where the
		   face falls in this particular shot. */
		transform: scale(4);
		transform-origin: 47% 33%;
	}

	.avatar-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #eee;
		color: var(--text-secondary);
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.intro h1 {
		margin: 0;
		font-size: 2rem;
		font-weight: 500;
	}

	.heading-group {
		min-width: 0;
	}

	/* Specificity needs to beat the generic `.intro p` rule below, which
	   would otherwise win (class+element beats class alone) and undo
	   this sizing/spacing. */
	.intro .byline {
		margin: 2px 0 0;
		font-size: 0.9375rem;
		color: var(--text-secondary);
	}

	.intro p {
		margin: 0.5rem 0 0;
		font-size: 1.125rem;
	}

	.bio {
		color: var(--text-secondary);
		font-size: 1rem;
		max-width: 40em;
	}

	.more-link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.more-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 20px;
		border: 1px solid currentColor;
		border-radius: 4px;
		color: inherit;
		font-size: 16px;
		text-decoration: none;
	}

	.button:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	@media (max-width: 599px) {
		.button {
			width: 100%;
			justify-content: center;
		}
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--text-secondary);
		font-size: 16px;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.social-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	#photos {
		scroll-margin-top: 2rem;
	}

	#photos:focus-visible {
		outline: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.site-footer {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 0 48px;
		color: var(--text-secondary, #666);
		font-size: 0.8125rem;
	}
</style>
