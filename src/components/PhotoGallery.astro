---
import { Image } from 'astro:assets';
import { getSortedPhotos, photoDetailsUrl, photoMatchesTag, photoUrl } from '../lib/photos.ts';
// TIERS/columnWidth/gridImageSizes live in a shared module (not just
// here) because index.astro needs the exact same `sizes` value, matched
// to the same `widths` array, to preload the homepage's LCP photo — see
// the comment on that preload for why an exact match matters. See
// grid.ts for the full reasoning behind the md/md2/lg/lg2 tier split.
import { OPEN_COLS, TIERS, columnWidth, gridImageSizes, gridImageSizesOpen } from '../lib/grid.ts';

interface Props {
	activeTag?: string;
	/**
	 * Slug of a photo to render already expanded, server-side. Set only by
	 * /photo/[slug]/index.astro — the URL an expanded tile puts in the
	 * address bar, so a shared link reopens the grid in the state the
	 * sender was looking at. The client script adopts this on page-load
	 * rather than resetting to collapsed; see the `astro:page-load`
	 * handler at the bottom of the expansion IIFE.
	 */
	openSlug?: string;
}

const { activeTag, openSlug } = Astro.props;

const ROW = 8;

function rowSpan(aspectRatio: number, width: number, gap: number) {
	const height = width / aspectRatio;
	return Math.ceil((height + gap) / (ROW + gap));
}

const photos = await getSortedPhotos();

// Every thumbnail link's DOM id is its photo's `slug` (see the `id` on
// .thumb-link below): the expansion script looks tiles up with
// getElementById, focuses them by id after a collapse, and derives each
// tile's view-transition-name from it. `slug` is already unique across
// photos (getSortedPhotos throws otherwise), but it's author-written
// text, so it can also collide with one of this page's own structural
// ids — and `photos` in particular is a real target (the close link
// returns to /#photos). A collision would silently point tileFor() at
// the wrong element instead of failing, so fail the build here instead.
const RESERVED_IDS = ['main', 'photos', 'photo-grid', 'photo-count'];
for (const photo of photos) {
	if (RESERVED_IDS.includes(photo.data.slug)) {
		throw new Error(
			`Photo slug "${photo.data.slug}" (${photo.id}) collides with a reserved element id on the gallery page. Rename the slug.`,
		);
	}
}

const tags = [...new Set(photos.flatMap((photo) => photo.data.tags))].sort();
// Pinned right after "All", ahead of the alphabetical tags, rather than
// sorted in among them — "featured" isn't a real tag (see photoMatchesTag),
// and its whole point is to be the quick, always-in-the-same-place way to
// see the highlight reel, not something you hunt for next to "wildlife".
const hasFeatured = photos.some((photo) => photo.data.feature);

const items = photos.map((photo) => {
	// `.clone` (not `photo.data.src.width` directly): astro:content wraps
	// every image() asset in a Proxy that marks it "referenced outside of
	// image processing" the moment ANY property is read off it directly
	// (see astro/dist/assets/utils/proxy.js) — and Astro's own build only
	// deletes the original, untransformed copy it writes to dist/_astro/
	// for images that AREN'T marked referenced (generate.js). `<Image>`/
	// getImage() read width/height too, but via this same `.clone` escape
	// hatch internally, specifically so their own metadata reads don't
	// trip that marking. Reading `.width`/`.height` straight off
	// `photo.data.src` here defeated that cleanup for every one of the 64
	// photos (all of them touch this line), leaving a 50MB orphaned
	// original per build that nothing ever links to. `.clone` returns a
	// plain (non-proxied) structuredClone of the same metadata, so
	// reading off it doesn't mark anything referenced.
	//
	// This isn't public API — Astro's own source comments it as "a
	// private, hidden prop" — so it could change on an Astro upgrade
	// without notice. If a future Astro version breaks this (orphaned
	// JPEGs reappear in `dist/_astro/`, checkable after `astro build`),
	// that's the first thing to check. It's also why this needs a cast:
	// `clone` isn't part of the public ImageMetadata type TypeScript
	// knows about, even though it exists at runtime.
	const { width, height } = (photo.data.src as unknown as { clone: typeof photo.data.src }).clone;
	const aspectRatio = width / height;

	// md2/lg2 share md/lg's column span — the split only changes which
	// row-height reference is active, not how many columns a tile spans.
	const lg2ColSpan = photo.data.feature ? 2 : 1;
	const lgColSpan = photo.data.feature ? 2 : 1;
	const md2ColSpan = photo.data.feature ? 2 : 1;
	const mdColSpan = photo.data.feature ? 2 : 1;
	const smColSpan = photo.data.feature ? 2 : 1;
	const xsColSpan = photo.data.feature ? 2 : 1;

	const lg2ColWidth = columnWidth(TIERS.lg2.container, TIERS.lg2.columns, TIERS.lg2.gap);
	const lgColWidth = columnWidth(TIERS.lg.container, TIERS.lg.columns, TIERS.lg.gap);
	const md2ColWidth = columnWidth(TIERS.md2.container, TIERS.md2.columns, TIERS.md2.gap);
	const mdColWidth = columnWidth(TIERS.md.container, TIERS.md.columns, TIERS.md.gap);
	const smColWidth = columnWidth(TIERS.sm.container, TIERS.sm.columns, TIERS.sm.gap);
	const xsColWidth = columnWidth(TIERS.xs.container, TIERS.xs.columns, TIERS.xs.gap);

	const lg2Width = lg2ColWidth * lg2ColSpan + TIERS.lg2.gap * (lg2ColSpan - 1);
	const lgWidth = lgColWidth * lgColSpan + TIERS.lg.gap * (lgColSpan - 1);
	const md2Width = md2ColWidth * md2ColSpan + TIERS.md2.gap * (md2ColSpan - 1);
	const mdWidth = mdColWidth * mdColSpan + TIERS.md.gap * (mdColSpan - 1);
	const smWidth = smColWidth * smColSpan + TIERS.sm.gap * (smColSpan - 1);
	const xsWidth = xsColWidth * xsColSpan + TIERS.xs.gap * (xsColSpan - 1);

	// Expanded (in-grid open) widths — same column-width math, just at
	// the wider OPEN_COLS span, so the recomputed row span actually
	// matches the aspect ratio at the width the tile will render at
	// once open. No JS measurement needed at click time because of this.
	const lg2OpenWidth = lg2ColWidth * OPEN_COLS.lg2 + TIERS.lg2.gap * (OPEN_COLS.lg2 - 1);
	const lgOpenWidth = lgColWidth * OPEN_COLS.lg + TIERS.lg.gap * (OPEN_COLS.lg - 1);
	const md2OpenWidth = md2ColWidth * OPEN_COLS.md2 + TIERS.md2.gap * (OPEN_COLS.md2 - 1);
	const mdOpenWidth = mdColWidth * OPEN_COLS.md + TIERS.md.gap * (OPEN_COLS.md - 1);
	const smOpenWidth = smColWidth * OPEN_COLS.sm + TIERS.sm.gap * (OPEN_COLS.sm - 1);
	const xsOpenWidth = xsColWidth * OPEN_COLS.xs + TIERS.xs.gap * (OPEN_COLS.xs - 1);

	const visible = !activeTag || photoMatchesTag(photo, activeTag);
	const open = photo.data.slug === openSlug;

	// Shared with index.astro's LCP preload — see the import comment above.
	const sizes = gridImageSizes(photo.data.feature);
	// Shared with /photo/[slug]/index.astro's LCP preload of the
	// server-rendered open tile — same reasoning as `sizes` above.
	const sizesOpen = gridImageSizesOpen();
	// The "featured" view shows only feature:true photos, so the editorial
	// 2-column span has nothing left to stand out against — at the
	// 3-column tiers (xs/sm/md/md2) every tile would be 2-of-3 wide with a
	// dense-pack gap beside it that nothing can fill. Feature photos should
	// still show wide under their *other* tags (a featured wildlife photo
	// stays big on /tag/wildlife/) — only the featured view itself flattens
	// them. "Flat" is that view's alternative: every photo forced to its
	// plain 1-column span, computed here (not measured) same as the *Open
	// numbers above. lg/lg2 are untouched (2-of-4 already divides evenly,
	// so "featured" never breaks it there) — deliberately no separate
	// `(min-width: 1100px)` lg2 step here the way `sizes`/`sizesOpen` above
	// have, reusing `lgWidth` all the way from 1000px up instead. Checked,
	// not just assumed: lgWidth vs lg2Width is 263px vs 288px (1-col) /
	// 542px vs 592px (2-col, feature), and both pairs round up to the same
	// srcset candidate at this project's 2x-DPR ceiling (650w / 1300w in
	// the widths array below) — so the "wrong" width here never actually
	// changes which file gets fetched, today. That's an accident of the
	// current widths array, not a guarantee: re-check this the same way if
	// the array's candidates ever move closer together near 650/1300, per
	// the Performance section's re-derive warning.
	const sizesFlat = `(min-width: 1000px) ${Math.round(lgWidth)}px, (min-width: 800px) ${Math.round(md2ColWidth)}px, (min-width: 600px) ${Math.round(mdColWidth)}px, (min-width: 400px) ${Math.round(smColWidth)}px, ${Math.round(xsColWidth)}px`;

	return {
		photo,
		visible,
		open,
		sizes,
		sizesOpen,
		sizesFlat,
		aspectRatio,
		lgColSpan,
		mdColSpan,
		smColSpan,
		lg2Rows: rowSpan(aspectRatio, lg2Width, TIERS.lg2.gap),
		lgRows: rowSpan(aspectRatio, lgWidth, TIERS.lg.gap),
		md2Rows: rowSpan(aspectRatio, md2Width, TIERS.md2.gap),
		mdRows: rowSpan(aspectRatio, mdWidth, TIERS.md.gap),
		smRows: rowSpan(aspectRatio, smWidth, TIERS.sm.gap),
		xsRows: rowSpan(aspectRatio, xsWidth, TIERS.xs.gap),
		lg2OpenRows: rowSpan(aspectRatio, lg2OpenWidth, TIERS.lg2.gap),
		lgOpenRows: rowSpan(aspectRatio, lgOpenWidth, TIERS.lg.gap),
		md2OpenRows: rowSpan(aspectRatio, md2OpenWidth, TIERS.md2.gap),
		mdOpenRows: rowSpan(aspectRatio, mdOpenWidth, TIERS.md.gap),
		smOpenRows: rowSpan(aspectRatio, smOpenWidth, TIERS.sm.gap),
		xsOpenRows: rowSpan(aspectRatio, xsOpenWidth, TIERS.xs.gap),
		md2FlatRows: rowSpan(aspectRatio, md2ColWidth, TIERS.md2.gap),
		mdFlatRows: rowSpan(aspectRatio, mdColWidth, TIERS.md.gap),
		smFlatRows: rowSpan(aspectRatio, smColWidth, TIERS.sm.gap),
		xsFlatRows: rowSpan(aspectRatio, xsColWidth, TIERS.xs.gap),
	};
});

const visibleCount = items.filter((item) => item.visible).length;

// Eager-load/high-priority slots must be keyed on position *among visible
// figures*, not position in the unfiltered collection — tag pages
// server-render all 64 figures and merely set `hidden` on non-matching
// ones (`hidden` doesn't stop an eager fetch), so keying on the raw
// collection index wastes eager slots on hidden figures while the
// actually-visible photos load `lazy`. On a narrow tag (e.g. a single
// matching photo sitting at collection index 60) that starves the one
// visible image entirely. -1 for hidden figures so they never match
// either check below.
//
// On /photo/<slug>/ the budget is skipped entirely rather than re-keyed
// (see `!openSlug` at both use sites): that page opens scrolled to its
// expanded tile, which is its LCP element and is preloaded as such, so
// the first six figures in DOM order are off-screen above the fold.
// Spending six eager fetches and a second fetchpriority="high" on them
// puts unrelated images in direct competition with the one the visitor
// actually came for — measured at index 60 of 64, that was 7 eager
// images and 2 high-priority ones for a single photo. The open tile's
// neighbours don't need the budget either: they're in the viewport once
// the scroll lands, and `loading="lazy"` never defers an in-viewport
// image.
let visibleIndex = -1;
const visibleIndexOf = items.map((item) => (item.visible ? ++visibleIndex : -1));
---

<nav class="filters" aria-label="Filter photos by tag">
	<a
		href="/"
		data-tag=""
		aria-current={!activeTag ? 'page' : undefined}
		class="filter-link"
	>
		All
	</a>
	{
		hasFeatured && (
			<a
				href="/tag/featured/"
				data-tag="featured"
				aria-current={activeTag === 'featured' ? 'page' : undefined}
				class="filter-link"
			>
				featured
			</a>
		)
	}
	{
		tags.map((tag) => (
			<a
				href={`/tag/${tag}/`}
				data-tag={tag}
				aria-current={activeTag === tag ? 'page' : undefined}
				class="filter-link"
			>
				{tag}
			</a>
		))
	}
</nav>

<div class="gallery">
	<!-- role=status/aria-live scoped to the counter only, not the whole
	     64-figure grid below: default aria-relevant is "additions text",
	     so with aria-live on .gallery, un-hiding ~58 figures on a filter
	     switch queued every one's long descriptive alt text for
	     announcement — a multi-minute queue on NVDA/JAWS. This element is
	     also reused to announce in-grid expand/collapse (see setTileOpen). -->
	<p class="visually-hidden" id="photo-count" role="status" aria-live="polite" aria-atomic="true">
		{visibleCount} photo{visibleCount === 1 ? '' : 's'}
	</p>
	<div class={`grid${activeTag === 'featured' ? ' is-featured' : ''}`} id="photo-grid">
		{
			items.map((item, index) => (
				<figure
					class={`item${item.open ? ' is-open' : ''}`}
					hidden={!item.visible}
					data-tags={[...item.photo.data.tags, ...(item.photo.data.feature ? ['featured'] : [])].join(
						' ',
					)}
					style={`--cols-sm:${item.smColSpan}; --cols-md:${item.mdColSpan}; --cols-lg:${item.lgColSpan}; --rows-xs:${item.xsRows}; --rows-sm:${item.smRows}; --rows-md:${item.mdRows}; --rows-md2:${item.md2Rows}; --rows-lg:${item.lgRows}; --rows-lg2:${item.lg2Rows}; --rows-xs-open:${item.xsOpenRows}; --rows-sm-open:${item.smOpenRows}; --rows-md-open:${item.mdOpenRows}; --rows-md2-open:${item.md2OpenRows}; --rows-lg-open:${item.lgOpenRows}; --rows-lg2-open:${item.lg2OpenRows}; --rows-xs-flat:${item.xsFlatRows}; --rows-sm-flat:${item.smFlatRows}; --rows-md-flat:${item.mdFlatRows}; --rows-md2-flat:${item.md2FlatRows}; --ar:${item.aspectRatio};`}
				>
					{
						/*
						  `autofocus` on the server-rendered open tile is the no-JS
						  half of "landing on /photo/<slug>/ shows you that photo".
						  The script's astro:page-load handler centers the tile with
						  scrollIntoView, but that needs JS; the browser scrolls an
						  autofocused element into view during the initial parse on
						  its own. Without it a no-JS visitor following a shared link
						  gets the top of a 64-photo grid with the photo they were
						  sent expanded somewhere far below (dense packing puts it
						  wherever it fits — index 60 of 64 in one measured case).
						  Only ever on the one open tile, so it can't fight itself.

						  It doesn't double up with the JS path: `autofocus` applies
						  only during a fresh Document parse, so ClientRouter swaps
						  (where it's silently ignored — see the same note on the
						  close control in /photo/[slug]/details.astro) are handled
						  by the scrollIntoView alone, and on a cold load the two
						  agree about which element matters — autofocus just gets it
						  roughly on screen, scrollIntoView then centers it.
						*/
					}
					<a
						href={photoUrl(item.photo.data.slug)}
						id={item.photo.data.slug}
						class="thumb-link"
						aria-expanded={item.open ? 'true' : 'false'}
						autofocus={item.open}
					>
						{
							/*
							  Picking srcset widths for this grid is unforgiving: the
							  browser fetches the *smallest* candidate that's still >=
							  the physical pixel need (CSS `sizes` value x devicePixelRatio),
							  so any candidate landing even slightly under a real need is
							  wasted — the browser skips straight to the next one up,
							  often 2x the bytes. Two earlier attempts at this array both
							  fell into that trap by picking round numbers without
							  re-deriving them against the actual need — each fix just
							  moved the shortfall up one tier (measured via Lighthouse
							  against the live site, full page scrolled so lazy tiles were
							  included in the trace: ~2.1MB wasted, then ~1.8MB).

							  This set is instead derived from two deliberate decisions:
							  1. Compute the physical-pixel need for every (breakpoint x
							     column-span) combination this grid produces — closed and
							     in-grid-open state both, since `sizesOpen` reuses the same
							     srcset — then pick candidates with headroom *over* each
							     one, not the nearest round number under it.
							  2. Cap the quality target at 2x device-pixel-ratio, not 3x.
							     Chasing full 3x (true native sharpness on the newest
							     phones) roughly doubles bytes again for a difference
							     that's imperceptible on a photo at normal viewing
							     distance — a real quality/bytes trade, not free, but a
							     well-established one. (This also matches Chrome DevTools'
							     "Improve image delivery" trace insight, which — verified
							     directly against `window.devicePixelRatio` while emulating
							     3x — scores as if DPR were ~1 regardless of the real
							     value, so it will keep flagging *some* residual "waste"
							     here no matter what; that residual is the 2x-vs-3x
							     sharpness this grid deliberately still pays for.)

							  Re-derive this (or re-run a full-page-scrolled trace) if
							  TIERS, OPEN_COLS, or the grid's gaps ever change.

							  550/1100/1400 were added later, for the *other* half of
							  the same trap: a candidate can also sit too far *above* a
							  real need. Replaying every `sizes` value against the 2x
							  target above turned up three places where the nearest
							  candidate overshot badly — 512-526 -> 650 (+25%),
							  1056-1084 -> 1300 (+23%), and 1322 -> 1800 (+36%). The
							  first of those is the phone-sized grid tile, i.e. the
							  homepage's LCP image: measured on a throttled connection
							  (1.6Mbps/150ms, 412x823 @1.75dpr, median of 5), serving it
							  at 550w instead of 650w moved LCP 1844ms -> 1512ms.

							  Note this does *not* relax the 2x target — every need is
							  still served by a candidate at or above 2x. It only closes
							  gaps between candidates. Nothing was removed either: 450
							  looks dead against the 2x math alone, but real devices span
							  dpr 1-3 and the browser picks on actual dpr, so the ladder
							  has to cover the continuum, not just the 2x points.
							*/
						}
						<Image
							src={item.photo.data.src}
							alt={item.photo.data.alt}
							widths={[150, 300, 450, 550, 650, 900, 1100, 1300, 1400, 1800]}
							sizes={
								item.open ? item.sizesOpen : activeTag === 'featured' ? item.sizesFlat : item.sizes
							}
							data-sizes={item.sizes}
							data-sizes-open={item.sizesOpen}
							data-sizes-flat={item.sizesFlat}
							loading={
								item.open || (!openSlug && visibleIndexOf[index] >= 0 && visibleIndexOf[index] < 6)
									? 'eager'
									: 'lazy'
							}
							fetchpriority={
								item.open || (!openSlug && visibleIndexOf[index] === 0) ? 'high' : undefined
							}
						/>
					</a>
					<div class="expand-overlay">
						<a
							href={photoDetailsUrl(item.photo.data.slug)}
							class="expand-link"
							aria-label="View full photo"
						>
							⤢
						</a>
					</div>
					{
						item.photo.data.caption && (
							// A figcaption must be a direct child of its figure for the
							// figure/figcaption relationship (and the accessible name it
							// gives the figure) to apply — it can't live inside
							// .expand-overlay like the old <p> did. .expand-caption below
							// reproduces .expand-overlay's aspect-ratio box independently
							// (see the comment there) so it still anchors to the image's
							// bottom edge rather than the figure's, which can be taller.
							<figcaption class="expand-caption">{item.photo.data.caption}</figcaption>
						)
					}
				</figure>
			))
		}
	</div>
</div>

<script is:inline>
	document.addEventListener('astro:page-load', () => {
		if (!document.getElementById('photo-grid')) return;
		let raw;
		try {
			raw = sessionStorage.getItem('focusPhoto');
			sessionStorage.removeItem('focusPhoto');
		} catch {
			return;
		}
		if (!raw) return;
		try {
			const { slug, ts } = JSON.parse(raw);
			// Only honor this if it's fresh — set as { slug, ts } (not a bare
			// slug) by /photo/[slug]/details.astro specifically so this expires. A
			// bare slug would keep pointing at whatever photo was last viewed
			// indefinitely: visit a photo, browse to /about/, come back to
			// / much later, and focus/scroll would get yanked to a photo
			// the user didn't just come from. The slug is also the thumbnail
			// link's DOM id (see .thumb-link above), so it's the lookup key
			// here directly.
			if (slug && Date.now() - ts < 5000) document.getElementById(slug)?.focus();
		} catch {}
	});
</script>

<script is:inline>
	(() => {
		// Filtering (tag nav clicks) and in-grid expansion used to be two
		// separate closures with no shared state — but expanding a tile
		// and then switching filters left the expanded tile's `is-open`
		// state and `openId` stale: a figure that doesn't match the new
		// tag could go `hidden` while still `is-open`, so filtering back
		// to a tag it does match brought it back already expanded with no
		// user action, and Escape there wrote a *filter* history entry
		// through the expand script's own null-state bug (see the
		// pushState/replaceState comment below). Merged into one IIFE so
		// the filter click handler can collapse any open tile first.
		//
		// Everything below still binds to `document`/`window`, never to
		// `.filters`/`#photo-grid` directly — ClientRouter replaces both
		// elements on every swap and does not re-execute an already-seen
		// inline script, so an element-bound listener would go stale the
		// first time you come back from /photo/[slug]/details.
		if (window.__photoGalleryInit) return;
		window.__photoGalleryInit = true;

		// Every id below is a photo's `slug` — that's what .thumb-link
		// carries as its DOM id, and (via /photo/<slug>/) what an open
		// tile puts in the address bar.
		let openId = null;
		// The grid URL to return to when a tile collapses. An open tile
		// replaces the address bar with the photo's own /photo/<slug>/ URL
		// (see the click handler), so `location` can't be read for this
		// while one is open — and it isn't always `/` either: /tag/<tag>/
		// is a grid page too, and a filter click makes it one client-side.
		// Set on every grid page-load and kept current by the filter
		// handler, both below.
		let gridUrl = location.pathname + location.search;

		function tileFor(id) {
			return document.getElementById(id)?.closest('figure') ?? null;
		}

		function setTileOpen(fig, open) {
			if (!fig) return;
			fig.classList.toggle('is-open', open);
			const img = fig.querySelector('img');
			// Closing back into the featured view must restore the
			// flattened `sizes` candidate, not the unfiltered one — see the
			// `.is-open` skip in applyFilter, which leaves this as the sole
			// owner of `sizes` while a tile is open.
			const featured = fig.closest('.grid')?.classList.contains('is-featured');
			img.sizes = open ? img.dataset.sizesOpen : featured ? img.dataset.sizesFlat : img.dataset.sizes;
			fig.querySelector('.thumb-link')?.setAttribute('aria-expanded', String(open));
		}

		// The thumbnail is a plain link to /photo/[slug]/ that JS turns into
		// a disclosure — visually obvious once it grows, but invisible to
		// AT otherwise (aria-expanded above covers the persistent state;
		// this covers the moment it changes). #photo-count is otherwise a
		// filter-count announcer (visually-hidden either way), reused here
		// rather than adding a second live region.
		function announce(message) {
			const count = document.getElementById('photo-count');
			if (!count) return;
			const prev = count.textContent;
			count.textContent = message;
			setTimeout(() => {
				if (count.textContent === message) count.textContent = prev;
			}, 1000);
		}

		// Only the figures currently on screen, so the reflow around the
		// toggled tile animates too — not every figure in the grid.
		function visibleIds() {
			const ids = [];
			const grid = document.getElementById('photo-grid');
			if (!grid) return ids;
			grid.querySelectorAll('figure:not([hidden])').forEach((fig) => {
				const r = fig.getBoundingClientRect();
				if (r.bottom > 0 && r.right > 0 && r.top < innerHeight && r.left < innerWidth) {
					ids.push(fig.querySelector('.thumb-link').id);
				}
			});
			return ids;
		}

		function setOpen(id) {
			const affected = new Set(visibleIds());
			if (openId) affected.add(openId);
			if (id) affected.add(id);

			function apply() {
				const previousOpenId = openId;
				if (previousOpenId && previousOpenId !== id) setTileOpen(tileFor(previousOpenId), false);
				if (id) setTileOpen(tileFor(id), true);
				openId = id;
				// Scrolling here, inside the update callback, rather than
				// after — grid-auto-flow: dense doesn't grow a tile in
				// place, it can relocate it anywhere once its column-span
				// changes, so there's no correct "center the tile" target
				// until this toggle has committed. Doing it here (not
				// after transition.finished) is what makes the grow and
				// the scroll read as one motion instead of two: every
				// currently-visible tile is individually named below, so
				// the transition interpolates *each of them* from its old
				// viewport position to its new (already-scrolled)
				// position, rather than cross-fading the whole page at a
				// fixed scroll offset.
				//
				// `behavior: 'instant'`, and the distinction is load-
				// bearing: `'auto'` does NOT mean "jump". Per CSSOM View
				// it defers to the computed `scroll-behavior`, and
				// Base.astro sets `html { scroll-behavior: smooth }` under
				// `prefers-reduced-motion: no-preference` — the same
				// condition that gates this transition, so the two are
				// always enabled together. `'auto'` therefore started a
				// real animated scroll running *concurrently* with the
				// view transition: exactly the second scroll animation
				// this comment used to claim was being avoided. The new-
				// state snapshots get captured while that scroll is still
				// in flight, so every tile interpolates toward an offset
				// the page hasn't reached yet and the whole grid snaps
				// when the transition ends. Worst in Firefox, whose
				// smooth scroll uses MSD physics with a longer settle than
				// Chrome's compositor-driven one, so it's still moving
				// well past the 400ms transition. `'instant'` is the only
				// value that actually guarantees the jump this relies on.
				//
				// A pure collapse (id is null) still needs a scroll target
				// — the tile that just closed, not the one that opened —
				// or dense packing can leave focus (see the callers below,
				// which focus with preventScroll: true) sitting off-screen
				// once the tile relocates back to its 1-column slot.
				const target = id ? tileFor(id) : previousOpenId ? tileFor(previousOpenId) : null;
				target?.scrollIntoView({ block: 'center', behavior: 'instant' });
			}

			const canAnimate =
				!matchMedia('(prefers-reduced-motion: reduce)').matches && document.startViewTransition;
			if (!canAnimate) {
				apply();
				return Promise.resolve();
			}

			// Names are id-derived and only ever live on one figure each,
			// assigned here and cleared below — never all up front, so no
			// figure can end up sharing a name with another.
			affected.forEach((tid) => {
				const fig = tileFor(tid);
				if (fig) fig.style.viewTransitionName = `photo-${tid}`;
			});
			const transition = document.startViewTransition(apply);
			// All three of a transition's promises reject if the document goes
			// hidden mid-transition (tab backgrounded, app-switched away from
			// on mobile) — expected, not an error, but left uncaught it's an
			// unhandled rejection on every one of them.
			transition.ready.catch(() => {});
			transition.finished.catch(() => {}).finally(() => {
				affected.forEach((tid) => {
					const fig = tileFor(tid);
					if (fig) fig.style.viewTransitionName = '';
				});
			});
			return transition.updateCallbackDone.catch(() => {});
		}

		// ---- tag filtering ----

		function applyFilter(tag) {
			const nav = document.querySelector('.filters');
			const grid = document.getElementById('photo-grid');
			const count = document.getElementById('photo-count');
			if (!nav || !grid || !count) return;
			// See the CSS comment on `.grid.is-featured` — the featured view
			// flattens feature photos' editorial 2-column span back to 1 so
			// the 3-column tiers don't dense-pack an unfillable gap next to
			// every tile. Only that view: a feature photo stays wide under
			// its other tags. That's driven by this class rather than a
			// full re-render, so it has to be kept in sync here alongside
			// hidden/aria-current/etc. — same reasoning as the title update
			// below.
			grid.classList.toggle('is-featured', tag === 'featured');
			let visible = 0;
			grid.querySelectorAll('figure').forEach((fig) => {
				const match = !tag || (fig.getAttribute('data-tags') ?? '').split(' ').includes(tag);
				fig.hidden = !match;
				if (match) visible++;
				// The flattened layout also renders feature photos narrower,
				// so their <img> needs the narrower `sizes` candidate too —
				// otherwise the browser still fetches for the wider box it
				// no longer occupies. Skipped for an open (in-grid-expanded)
				// tile: its `sizes` is owned by setTileOpen and must win.
				const img = fig.querySelector('img');
				if (img && !fig.classList.contains('is-open')) {
					img.sizes = tag === 'featured' ? img.dataset.sizesFlat : img.dataset.sizes;
				}
			});
			count.textContent = `${visible} photo${visible === 1 ? '' : 's'}`;
			nav.querySelectorAll('a').forEach((a) => {
				if (a.getAttribute('data-tag') === tag) a.setAttribute('aria-current', 'page');
				else a.removeAttribute('aria-current');
			});
			// Filtering is a pushState, not a real navigation — deliberately
			// leaves the h1/lead/<title> untouched here. They stay whatever
			// they were on load (e.g. "Nick Huijgen" / "Photography from
			// wherever I end up." on the homepage) no matter which tag is
			// showing, by design: the page head shouldn't visibly change
			// just from clicking a filter pill.
			// So /photo/[slug]'s Close link can send you back to the filtered
			// view you actually came from instead of always the unfiltered
			// grid — that page is a separate static route with no way to
			// know this at render time, so it reads this back out of
			// sessionStorage instead. Kept in sync here rather than only
			// when the "⤢" expand-full-photo link is clicked, since that's
			// a plain, un-intercepted navigation this script can't hook.
			sessionStorage.setItem('activeTag', tag);
		}

		// Fades departing/arriving tiles and slides the rest into their new
		// dense-packed slots when the filter changes. Only tiles on screen
		// get a view-transition-name (same trick as the expand script
		// below) — naming the whole library would scale the animation's
		// cost with photo count instead of viewport size, and off-screen
		// tiles don't need to visibly move anyway.
		function render(tag) {
			const grid = document.getElementById('photo-grid');
			const canAnimate =
				grid && !matchMedia('(prefers-reduced-motion: reduce)').matches && document.startViewTransition;
			if (!canAnimate) {
				applyFilter(tag);
				return;
			}
			const visibleFigs = [...grid.querySelectorAll('figure:not([hidden])')].filter((fig) => {
				const r = fig.getBoundingClientRect();
				return r.bottom > 0 && r.right > 0 && r.top < innerHeight && r.left < innerWidth;
			});
			visibleFigs.forEach((fig) => {
				fig.style.viewTransitionName = `photo-${fig.querySelector('.thumb-link').id}`;
			});
			const transition = document.startViewTransition(() => applyFilter(tag));
			// All three of a transition's promises reject if the document goes
			// hidden mid-transition (tab backgrounded, app-switched away from
			// on mobile) — expected, not an error, but left uncaught it's an
			// unhandled rejection on every one of them.
			transition.ready.catch(() => {});
			transition.updateCallbackDone.catch(() => {});
			transition.finished.catch(() => {}).finally(() => {
				visibleFigs.forEach((fig) => (fig.style.viewTransitionName = ''));
			});
		}

		// Capture phase — see the note by the expand click handler below:
		// ClientRouter's own document click listener is registered first
		// and would navigate before a bubble-phase preventDefault landed.
		document.addEventListener(
			'click',
			(e) => {
				const a = e.target.closest?.('.filters a');
				if (!a) return;
				e.preventDefault();
				// Close any open tile before switching filters. Without
				// this, a figure that doesn't match the new tag could go
				// `hidden` while still `is-open` (openId untouched, sizes
				// still the expanded candidate) — filtering back to a tag
				// it does match then brought it back already expanded with
				// no user action. No transition/scroll needed for this
				// collapse: the filter's own render() below already
				// animates the switch, and this click's own pushState
				// replaces the open tile's /photo/<slug>/ URL with the
				// tag's anyway.
				if (openId) {
					setTileOpen(tileFor(openId), false);
					openId = null;
				}
				const tag = a.getAttribute('data-tag') ?? '';
				render(tag);
				// This href is the grid page for the new filter, so it's
				// also where a tile opened *after* this click collapses
				// back to.
				gridUrl = a.getAttribute('href');
				history.pushState({ ...history.state, tag, photoOpen: null }, '', gridUrl);
			},
			true,
		);

		window.addEventListener('popstate', (e) => {
			if (!e.state || typeof e.state.tag !== 'string') return;
			// Back out of an open tile pops onto the grid entry this filter
			// is already showing (that entry's URL and filter never
			// changed — only the tile did), so check before animating: a
			// re-render to the tag that's already applied is invisible, but
			// it still starts a view transition, and that one would be
			// competing with the swap ClientRouter does for the same pop.
			const nav = document.querySelector('.filters');
			const current = nav?.querySelector('[aria-current="page"]')?.getAttribute('data-tag') ?? '';
			if (current === e.state.tag) return;
			render(e.state.tag);
		});

		document.addEventListener('astro:page-load', () => {
			const nav = document.querySelector('.filters');
			if (!nav) return;
			const initialTag = nav.querySelector('[aria-current="page"]')?.getAttribute('data-tag') ?? '';
			history.replaceState({ ...history.state, tag: initialTag }, '', location.href);
			// Covers landing directly on /tag/[tag] (already server-filtered,
			// so render()'s own sessionStorage write below never fires
			// unless a filter tab is actually clicked).
			//
			// Skipped on /photo/<slug>/: that route has no tag in its URL to
			// render, so it always draws the nav with "All" current and
			// `initialTag` is unconditionally '' there — writing that would
			// wipe a filter the visitor still has, without them touching a
			// filter pill at all. Reachable in four steps: on /tag/wildlife/
			// expand a tile (a pushState, so this doesn't fire), follow ⤢ to
			// the detail page, then press Back rather than Close.
			// ClientRouter re-fetches /photo/<slug>/, this handler runs, and
			// from then on the detail page's Close link returns to the
			// unfiltered grid instead of /tag/wildlife/. Leaving the stored
			// value alone is right for the other arrival too: a shared link
			// starts a session with nothing stored, so there's nothing to
			// preserve and nothing to clear.
			if (!location.pathname.startsWith('/photo/')) {
				sessionStorage.setItem('activeTag', initialTag);
			}
		});

		// ---- in-grid expansion ----
		// (openId, tileFor, setTileOpen, visibleIds, setOpen are declared
		// above, shared with the filter click handler's collapse-on-filter
		// fix.)

		// Capture phase, not bubble: ClientRouter registers its own
		// document-level click listener from <head>, so it would other-
		// wise run first and navigate away before we ever preventDefault.
		// It does bail on ev.defaultPrevented — we just have to get there
		// first, and document-capture is the earliest point in the path.
		document.addEventListener(
			'click',
			(e) => {
				const a = e.target.closest?.('.thumb-link');
				if (!a || !a.closest('#photo-grid')) return;
				e.preventDefault();
				const id = a.id;
				const next = openId === id ? null : id;
				// An open tile puts the photo's own /photo/<slug>/ URL in
				// the address bar — the same URL this `<a>` points at for
				// no-JS — rather than a hash on the grid's URL. It used to
				// be a hash (`/#<slug>`), which had the nice property that
				// refreshing or sharing it reopened the tile in place; the
				// dealbreaker is that a fragment is never sent to a server
				// and every link-preview scraper drops it, so a shared
				// "look at this photo" URL always embedded the homepage's
				// og:image (the featured photo) instead of the photo the
				// sender had open. /photo/<slug>/ is a real prerendered
				// page with that photo's own og:image, so sharing it
				// previews the right image.
				//
				// That page is this same grid with this tile expanded
				// server-side, not a separate full-screen view: the URL in
				// the address bar and the page served at it show the same
				// thing, so following a shared link reopens exactly what
				// the sender was looking at instead of dropping the
				// recipient somewhere they have to close out of. The
				// full-screen view is still there, one step deeper, at
				// /photo/<slug>/details/ behind the ⤢ control.
				//
				// ClientRouter doesn't navigate behind our back over this:
				// it tracks its own `originalLocation` (see router.js) and
				// only updates it in moveToLocation, i.e. on navigations it
				// performs itself — a manual pushState leaves it pointing
				// at the grid page, so the "⤢" link's plain navigation to
				// this same /photo/<slug>/ URL is still a real navigation
				// to it, not a same-page no-op.
				//
				// State must NOT be a literal `null` — ClientRouter keeps
				// its own bookkeeping on every entry ({ index, scrollX,
				// scrollY }, see router.js) and never repairs an entry
				// whose state was overwritten. Writing `null` here used to
				// permanently corrupt that entry: ClientRouter's onPopState
				// bails early on `ev.state === null`, and it keeps bailing
				// for *any future arrival* at this entry, not just the
				// same-page back/forward this was meant for — e.g. expand a
				// tile, navigate to /about/, then Back would silently no-op
				// instead of returning here. Spreading `...history.state`
				// preserves that bookkeeping.
				if (next)
					history.pushState(
						{ ...history.state, photoOpen: next },
						'',
						`/photo/${encodeURIComponent(next)}/`,
					);
				else history.replaceState({ ...history.state, photoOpen: null }, '', gridUrl);
				setOpen(next).then(() => {
					document.getElementById(id)?.focus({ preventScroll: true });
					announce(next ? 'Photo expanded' : 'Photo collapsed');
				});
			},
			true,
		);

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape' || !openId) return;
			const id = openId;
			// See the pushState/replaceState comment above the click handler:
			// never write a literal `null` state here either, or Back stops
			// working for this entry the same way. `gridUrl`, not
			// `location`: the open tile's URL is /photo/<slug>/, so
			// collapsing has to restore the grid's own URL from the
			// variable that remembers it.
			history.replaceState({ ...history.state, photoOpen: null }, '', gridUrl);
			setOpen(null).then(() => {
				document.getElementById(id)?.focus({ preventScroll: true });
				announce('Photo collapsed');
			});
		});

		window.addEventListener('popstate', () => {
			// Only meaningful while the grid is on screen; if ClientRouter
			// swapped us elsewhere the fresh page starts collapsed anyway.
			if (!document.getElementById('photo-grid')) return;
			// Back out of an open tile lands on the grid's own URL — that's
			// a collapse, in place. A pop *onto* a /photo/<slug>/ entry (a
			// Forward after that Back) is a navigation ClientRouter is
			// already fetching and swapping in — and what it swaps in is
			// this same grid with that tile expanded server-side, which the
			// astro:page-load handler below adopts. Don't race that with a
			// view transition here, and don't reopen a tile on a page
			// that's about to be replaced.
			if (location.pathname.startsWith('/photo/')) return;
			gridUrl = location.pathname + location.search;
			// Collapsed directly, not through setOpen(): a Back from an
			// open tile leaves the grid's URL unchanged from
			// ClientRouter's point of view (its `originalLocation` never
			// saw our pushState), so it re-fetches and swaps in this same
			// grid page — a second, concurrent view transition here would
			// only be aborted by that swap's own one.
			if (openId) {
				setTileOpen(tileFor(openId), false);
				openId = null;
			}
		});

		document.addEventListener('astro:page-load', () => {
			const grid = document.getElementById('photo-grid');
			if (!grid) return;
			// /photo/<slug>/ serves this same grid with one tile already
			// expanded server-side (PhotoGallery's `openSlug` prop), so a
			// shared link reopens what the sender was looking at. Adopt that
			// tile rather than resetting to collapsed: with openId left null
			// the first click on the open tile would read as "open" rather
			// than "collapse", and Escape wouldn't know there was anything
			// to close. Every other grid arrival (`/`, `/tag/<tag>/`, a Back
			// that ClientRouter served by re-fetching the grid) has no
			// .is-open figure and lands on null exactly as before.
			const openFig = grid.querySelector('figure.is-open');
			openId = openFig?.querySelector('.thumb-link')?.id ?? null;
			// Collapsing has to restore a *grid* URL, and on /photo/<slug>/
			// `location` is the open tile's own URL rather than a grid one —
			// so fall back to the unfiltered grid there. A shared link
			// carries no filter to preserve, which is the only way to arrive
			// with a tile already open.
			gridUrl = openId ? '/' : location.pathname + location.search;
			// Dense packing puts an expanded tile wherever it fits, which on
			// a 64-photo grid is usually far below the fold — so arriving at
			// /photo/<slug>/ without this shows the top of the grid instead
			// of the photo the URL names. Same centering setOpen does, and
			// 'instant' for the same reason (see the note there on `auto`
			// deferring to `scroll-behavior: smooth`).
			openFig?.scrollIntoView({ block: 'center', behavior: 'instant' });
		});
	})();
</script>

