			grid-row: span var(--rows-lg-open);
		}
	}

	/* Matches the image box, not the figure: the figure is usually a bit
	   taller than the image because row spans quantise to whole rows, so
	   `inset: 0` would float the caption in the gap below the photo. */
	.expand-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		aspect-ratio: var(--ar);
		display: none;
		pointer-events: none;
	}

	.item.is-open .expand-overlay {
		display: block;
	}

	.expand-link {
		position: absolute;
		top: 8px;
		right: 8px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		border-radius: 50%;
		/* 0.45 composited over a bright photo (sky, snow, blown highlights)
		   measured 3.36:1 for the white glyph — fails AA. 0.65 -> 7.00:1. */
		background: rgba(0, 0, 0, 0.65);
		color: #fff;
		text-decoration: none;
		font-size: 18px;
		line-height: 1;
		pointer-events: auto;
	}

	.expand-link:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	/* Windows High Contrast strips background colors (including this
	   rgba scrim), leaving the "⤢" glyph with no visible boundary
	   against the photo. A forced-colors-safe outline keeps it legible. */
	@media (forced-colors: active) {
		.expand-link {
			outline: 1px solid CanvasText;
		}
	}

	/* Independently reproduces .expand-overlay's "match the image box, not
	   the figure" sizing (see the comment there) now that this is a
	   sibling rather than a child of it — needed so `top: 0` +
	   `aspect-ratio` anchor this to the image's real bottom edge instead
	   of the figure's, which can be taller once row spans quantise to
	   whole rows. flex + justify-content: flex-end then bottom-aligns
	   the caption text within that box, matching the old bottom-anchored
	   <p>'s position pixel-for-pixel. */
	.expand-caption {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		aspect-ratio: var(--ar);
		display: none;
		flex-direction: column;
		justify-content: flex-end;
		margin: 0;
		padding: 32px 12px 12px;
		/* Fixed pixel stops, not percentages: percentages would scale the
		   gradient's shape with the box height above (tiny on a closed
		   thumbnail, huge on an open tile), while the text always sits in
		   a fixed-height strip at the very bottom regardless. The old
		   `rgba(0,0,0,0.7) -> transparent` fade measured ~35% alpha right
		   where the first line of text sits (~2.4:1, fails badly) — this
		   keeps a solid floor under the text itself and only fades above
		   it, independent of box height. 0.65 matches .control/.expand-link
		   above (7.00:1 for white text). */
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.65) 0,
			rgba(0, 0, 0, 0.65) 56px,
			transparent 120px
		);
		color: #fff;
		font-size: 0.875rem;
		pointer-events: none;
	}

	.item.is-open .expand-caption {
		display: flex;
	}
</style>
