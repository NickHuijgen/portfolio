	}

	.thumb-link:focus-visible {
		outline: 2px solid #1a73e8;
		outline-offset: 2px;
	}

	/* In-grid expansion. Column spans here (3/2/3) must match
	   OPEN_COLS in the frontmatter — Astro <style> blocks can't read
